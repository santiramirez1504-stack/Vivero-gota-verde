PORT=4000

# Origen(es) permitido(s) para CORS, separados por coma
CLIENT_ORIGIN=http://localhost:5173

# Genera un secreto largo y aleatorio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Usuario y contraseña del panel de administración.
# ADMIN_PASSWORD_HASH se genera con bcrypt (ver README del backend / instrucciones del módulo 5.1)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Credenciales del panel del DESARROLLADOR (kill switch) — exclusivas, NO compartir con el cliente
DEV_USER=
DEV_PASSWORD_HASH=

# Credenciales de Cloudinary (gratis en cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta donde se guardan los archivos subidos dentro de tu cuenta de Cloudinary
CLOUDINARY_FOLDER=vivero-gota-verde

# Cadena de conexión de MongoDB Atlas (gratis en mongodb.com/cloud/atlas)
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/vivero-gota-verde?retryWrites=true&w=majority
MONGODB_URI=
